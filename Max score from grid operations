class Solution {
    public long maximumScore(int[][] grid) {
        int n = grid.length;

        if (n == 1)
            return 0;

        long[][] s = new long[n][n + 1];

        for (int j = 0; j < n; j++) {
            for (int i = 0; i < n; i++) {
                s[j][i + 1] = s[j][i] + grid[i][j];
            }
        }

        long INF = Long.MIN_VALUE / 2;

        long[][] dp = new long[n + 1][n + 1];

        for (int i = 0; i <= n; i++) {
            for (int j = 0; j <= n; j++) {
                dp[i][j] = INF;
            }
        }

        for (int h = 0; h <= n; h++) {
            dp[h][0] = 0;
        }

        for (int col = 0; col < n - 1; col++) {
            long[][] next = new long[n + 1][n + 1];

            for (int i = 0; i <= n; i++) {
                for (int j = 0; j <= n; j++) {
                    next[i][j] = INF;
                }
            }

            for (int h1 = 0; h1 <= n; h1++) {
                long[] pre = new long[n + 2];
                long[] suf = new long[n + 2];

                for (int i = 0; i <= n + 1; i++) {
                    pre[i] = INF;
                    suf[i] = INF;
                }

                pre[0] = dp[h1][0];

                for (int h2 = 1; h2 <= n; h2++) {
                    pre[h2] = Math.max(pre[h2 - 1], dp[h1][h2]);
                }

                for (int h2 = n; h2 >= 0; h2--) {
                    long val = INF;

                    if (dp[h1][h2] != INF) {
                        val = dp[h1][h2] +
                              Math.max(0L, s[col][h2] - s[col][h1]);
                    }

                    suf[h2] = Math.max(suf[h2 + 1], val);
                }

                for (int hp = 0; hp <= n; hp++) {
                    long add = Math.max(0L, s[col][hp] - s[col][h1]);

                    long v1 = INF;

                    if (pre[hp] != INF) {
                        v1 = pre[hp] + add;
                    }

                    next[hp][h1] = Math.max(v1, suf[hp + 1]);
                }
            }

            dp = next;
        }

        long ans = 0;

        for (int h1 = 0; h1 <= n; h1++) {
            for (int h2 = 0; h2 <= n; h2++) {
                if (dp[h1][h2] != INF) {
                    ans = Math.max(
                        ans,
                        dp[h1][h2] +
                        Math.max(0L, s[n - 1][h2] - s[n - 1][h1])
                    );
                }
            }
        }

        return ans;
    }
}
